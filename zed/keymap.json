// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  // {
  //   "context": "VimControl && !menu",
  //   "bindings": {
  //     "space f": "file_finder::Toggle",
  //   },
  // },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "space b b": "tab_switcher::OpenInActivePane",
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore"
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-'": "terminal_panel::Toggle",
    },
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-'": "editor::ToggleSelectedDiffHunks",
    },
  },
  {
    "context": "(VimControl && vim_mode == normal)",
    "bindings": {
      "space w": "workspace::Save",
    },
  },
  {
    "context": "(VimControl && vim_mode == normal)",
    "bindings": {
      "space b c": "pane::CloseActiveItem",
    },
  },
  {
    "bindings": {
      "alt--": "zed::DecreaseUiFontSize",
    },
  },
  {
    "bindings": {
      "alt-=": "zed::IncreaseUiFontSize",
    },
  },
  {
    "context": "(vim_mode == helix_normal || vim_mode == helix_select) && !menu",
    "unbind": {
      "space c": [
        "editor::ToggleComments",
        {
          "advance_downwards": false,
          "comment_empty_lines": false,
        },
      ],
    },
  },
  {
    "context": "ProjectPanel",
    "unbind": {
      "ctrl-n": "project_panel::NewFile",
    },
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      "ctrl-shift-n": "project_panel::NewFile",
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "alt-v": "workspace::ToggleVimMode",
    },
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-z": "editor::Undo",
    },
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-k ctrl-i": "editor::Hover",
    },
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-k ctrl-b": "editor::BlameHover",
    },
  },
  {
    "bindings": {
      "ctrl-k f": "workspace::CloseProject",
    },
  },
  {
    "context": "vim_mode == helix_normal",
    "bindings": {
      "ctrl-s": "workspace::Save",
    },
  },
  {
    // "context": "",
    "bindings": {
      "alt-x": ["workspace::SendKeystrokes", "escape"],
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-=": [
        "zed::IncreaseBufferFontSize",
        {
          "persist": false,
        },
      ],
    },
  },
  {
    "context": "vim_mode == normal || vim_mode == visual",
    "bindings": {
      ">": "editor::Indent",
    },
    "unbind": {
      ">": "vim::Indent",
    },
  },
  {
    "context": "vim_mode == normal || vim_mode == visual",
    "bindings": {
      "<": "editor::Outdent",
    },
    "unbind": {
      "<": "vim::Outdent",
    },
  },
]
