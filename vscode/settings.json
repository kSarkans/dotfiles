        "PATH": "/home/ksarkans/.vscode/extensions/stmicroelectronics.stm32cube-ide-build-cmake-1.44.0-linux-x64/resources/cube-cmake/linux/x86_64:/home/ksarkans/.vscode/extensions/stmicroelectronics.stm32cube-ide-core-1.2.1-linux-x64/resources/binaries/linux/x86_64:${env.PATH}"
    },
    "stm32cube-ide-build-cmake.ignoreCubeProjectDiscovery": true,
