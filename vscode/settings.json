        "request": "launch",
        "externalConsole": false,
        "cwd": "${command:cmake.launchTargetDirectory}"
    },
    "cmake.copyCompileCommands": "${workspaceFolder}/compile_commands.json",
    "cmake.defaultActiveFolder": "${workspaceFolder}",
    "cmake.autoSelectActiveFolder": false,
    "cmake.deleteBuildDirOnCleanConfigure": true,
    "cmake.setBuildTypeOnMultiConfig": true,
    "cmake.options.statusBarVisibility": "compact",
    "cmake.revealLog": "never",
    /***********************************************************************/
    "makefile.configureOnOpen": true,
    /***********************************************************************/
    "git.confirmSync": false,
    "git.openRepositoryInParentFolders": "never",
    /***********************************************************************/
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false
    },
    /***********************************************************************/
    "terminal.integrated.fontLigatures.enabled": true,
    /***********************************************************************/
    "debug.console.fontSize": 11,
    "debug.breakpointsView.presentation": "tree",
