            "rootFolderNames": [
                "framework",
                "Framework",
            ]
        },
        {
            "name": "thirdparty-folder",
            "base": "lib",
            "color": "blue-600",
            "lightColor": "blue-800",
            "folderNames": [
                "thirdparty",
                "ThirdParty",
                "3rdparty",
                "3rdParty",
                "external",
                "External",
            ],
            "rootFolderNames": [
                "thirdparty",
                "ThirdParty",
                "3rdparty",
                "3rdParty",
                "external",
                "External",
            ]
        }
