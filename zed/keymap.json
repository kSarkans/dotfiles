// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore"
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-'": "terminal_panel::Toggle"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-'": "editor::ToggleSelectedDiffHunks"
    }
  },
  {
    "context": "(VimControl && vim_mode == normal)",
    "bindings": {
      "space w": "workspace::Save"
    }
  },
  {
    "context": "(VimControl && vim_mode == normal)",
    "bindings": {
      "space c": "pane::CloseActiveItem"
    }
  },
  {
    "bindings": {
      "ctrl-shift-k f": "workspace::CloseProject"
    }
  },
  {
    "bindings": {
      "alt--": "zed::DecreaseUiFontSize"
    }
  },
  {
    "bindings": {
      "alt-=": "zed::IncreaseUiFontSize"
    }
  },
  {
    "context": "(vim_mode == helix_normal || vim_mode == helix_select) && !menu",
    "unbind": {
      "space c": [
        "editor::ToggleComments",
        {
          "advance_downwards": false,
          "comment_empty_lines": false
        }
      ]
    }
  },
  {
    "context": "ProjectPanel",
    "unbind": {
      "ctrl-n": "project_panel::NewFile"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-shift-n": "workspace::NewWindow"
    }
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      "ctrl-shift-n": "project_panel::NewFile"
    }
  },
  {
    "context": "Editor",
      "bindings": {
      "alt-v": "workspace::ToggleVimMode"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-z": "editor::Undo"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-shift-k ctrl-i": "editor::Hover"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-k ctrl-i": "editor::Hover"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-shift-k ctrl-b": "editor::BlameHover"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-k ctrl-b": "editor::BlameHover"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-shift-k ctrl-t": "theme_selector::Toggle"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-k ctrl-t": "theme_selector::Toggle"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-shift-k ctrl-shift-t": "theme::ToggleMode"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-k ctrl-shift-t": "theme::ToggleMode"
    }
  }
]
