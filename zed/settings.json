// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "show_whitespaces": "selection",
  "auto_indent": "preserve_indent",
  "vertical_scroll_margin": 5.0,
  "hard_tabs": false,
  "vim_mode": true,
  "vim": {
    "cursor_shape": {
      "insert": "bar"
    },
  },
  "base_keymap": "VSCode",
  "relative_line_numbers": "enabled",
  "mouse_wheel_zoom": true,
  "gutter": {
    "line_numbers": true
  },
  "minimap": {
    "show": "always"
  },
  "buffer_font_family": "ZedMono Nerd Font",
  "file_types": {
    "ini": [
      "*.gdextension",
      "*.ltx",
      "*.godot",
      "fust.*"
    ],
    "xml": [
      "*.ui",
      "*.lang"
    ],
    "yaml": [
      ".clang-format",
      ".clang-tidy",
      ".clangd"
    ],
    "lua": [
      "*.script"
    ],
    "cpp": [
      "*.inc"
    ],
    "python": [
      "SCsub"
    ],
    "xmake": [
      "xmake.lua",
      "*/xmake/*.lua"
    ]
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "format_on_save": "off",
  "title_bar": {
    "show_menus": false,
  },
  "project_panel": {
    "auto_fold_dirs": false,
    "dock": "left",
    "entry_spacing": "comfortable",
    "file_icons": true,
    "button": true,
  },
  "icon_theme": {
    "mode": "dark",
    "light": "JetBrains New UI Icons (Light)",
    "dark": "Zed (Default)"
  },
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "theme": {
    "mode": "dark",
    "light": "JetBrains Islands Light",
    "dark": "Ayu Mirage",
  },
  "soft_wrap": "editor_width",
  "restore_on_startup": "launchpad",
  "languages":
  {
    "CMake": {
      "tab_size": 4
    },
    "C++":{
      "soft_wrap": "editor_width",
      "formatter": {
        "external": {
          "command": "clang-format",
          "arguments": ["{buffer_path}"]
        }
      }
    },
    "CSharp": {
      "language_servers": ["roslyn"]
    },
    "xmake": {
      "hard_tabs": false,
      "tab_size": 4
    },
    "GDScript": {
      "hard_tabs": true,
      "tab_size": 4
    }
  },
  "snippet_sort_order": "inline",
  "auto_signature_help": false,
  "show_signature_help_after_edits": false,
  "show_completions_on_input": true,
  "ensure_final_newline_on_save": false,
}
