                "targets",
                "Targets",
            ]
        },
        {
            "name": "platform-folder",
            "base": "shared",
            "color": "indigo-400",
            "lightColor": "indigo-600",
            "folderNames": [
                "platform",
                "Platform",
            ],
            "rootFolderNames": [
                "platform",
                "Platform",
            ]
        },
        {
            "name": "engine-folder",
