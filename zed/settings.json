// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "window_title_format": "${projectName}${separator}${fileName}",
  "prettier": {
    "parser": "",
  },
  "line_ending": "prefer_lf",
  "current_line_highlight": "none",
  "colorize_brackets": false,
  "helix_mode": false,
  "use_system_path_prompts": false,
  "agent": {
    "button": false,
    "favorite_models": [],
    "model_parameters": [],
  },
  "collaboration_panel": {
    "default_width": 280.0,
  },
  "debugger": {
    "dock": "left",
  },
  "git_panel": {
    "file_icons": false,
    "tree_view": true,
    "fallback_branch_name": "trunk",
    "status_style": "icon",
    "default_width": 280.0,
    "dock": "left",
  },
  "focus_follows_mouse": {
    "enabled": false,
  },
  "bottom_dock_layout": "contained",
  "tabs": {
    "show_close_button": "hover",
    "show_diagnostics": "errors",
    "close_position": "right",
    "file_icons": true,
  },
  "use_smartcase_search": true,
  "scrollbar": {
    "show": "never",
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
    "button": true,
  },
  "search": {
    "regex": true,
    "button": true,
  },
  "enable_language_server": true,
  "status_bar": {
    "line_endings_button": true,
    "cursor_position_button": true,
    "active_encoding_button": "enabled",
    "active_language_button": true,
    "show_active_file": true,
  },
  "hover_popover_sticky": false,
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": false,
    "show_tab_bar_buttons": false,
    "show_nav_history_buttons": false,
    "show": true,
  },
  "relative_line_numbers": "enabled",
  "cursor_shape": "block",
  "indent_guides": {
    "coloring": "fixed",
    "background_coloring": "disabled",
    "enabled": false,
  },
  "soft_wrap": "editor_width",
  "sticky_scroll": {
    "enabled": true,
  },
  "cursor_animation": {
    "enabled": true,
  },
  "buffer_font_family": "ZedMono Nerd Font Propo",
  "gutter": {
    "breakpoints": true,
    "bookmarks": true,
    "min_line_number_digits": 0,
    "folds": false,
    "runnables": false,
    "line_numbers": true,
  },
  "inlay_hints": {
    "enabled": false,
  },
  "show_whitespaces": "selection",
  "whitespace_map": {
    "space": "•",
    "tab": "→",
  },
  "ensure_final_newline_on_save": true,
  "toolbar": {
    "code_actions": false,
    "agent_review": false,
    "selections_menu": false,
    "quick_actions": false,
    "breadcrumbs": false,
  },
  "outline_panel": {
    "indent_size": 20.0,
    "default_width": 400.0,
    "dock": "left",
    "button": true,
  },
  "disable_ai": true,
  "default_open_behavior": "existing_window",
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "button": true,
    "dock": "right",
    "hide_hidden": false,
    "git_status_indicator": false,
    "bold_folder_labels": true,
    "auto_reveal_entries": true,
    "indent_size": 14.0,
    "file_icons": true,
    "entry_spacing": "standard",
    "hide_gitignore": false,
    "title_tooltip_delay": "default",
    "default_width": 280.0,
    "sort_order": "default",
    "folder_indicator": "icon",
    "hide_root": false,
    "auto_fold_dirs": false,
  },
  "ui_font_family": "ZedMono Nerd Font Propo",
  "agent_buffer_font_size": 15.0,
  "agent_buffer_font_family": "ZedMono Nerd Font Propo",
  "mouse_wheel_zoom": true,
  "restore_on_startup": "launchpad",
  "minimap": {
    "max_width_columns": 80,
    "thumb": "always",
    "show": "never",
  },
  "vertical_scroll_margin": 5.0,
  "semantic_tokens": "combined",
  "title_bar": {
    "button_layout": "standard",
    "show_sign_in": true,
    "show_onboarding_banner": true,
    "show_project_items": true,
    "show_branch_status_icon": true,
    "show_user_menu": true,
    "show_menus": false,
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "buffer_line_height": "comfortable",
  "terminal": {
    "dock": "bottom",
    "font_size": 20.0,
    "show_count_badge": false,
    "font_family": "ZedMono Nerd Font Propo",
  },
  "vim_mode": true,
  "vim": {
    "highlight_on_yank_duration": 250,
    "cursor_shape": {
      "normal": "block",
      "insert": "bar",
      "visual": "hollow",
      "replace": "underline",
    },
    "use_system_clipboard": "on_yank",
    "use_smartcase_find": true,
    "toggle_relative_line_numbers": false,
  },
  "base_keymap": "Zed",
  "session": {
    "trust_all_worktrees": true,
  },
  "ui_font_size": 16.0,
  "buffer_font_size": 20.0,
  "theme": {
    "mode": "dark",
    "light": "GitHub Light",
    "dark": "Netherlight",
  },
  "completions": {
    "lsp_insert_mode": "insert",
  },
  "buffer_font_features": {
    "calt": false,
  },
  "languages": {
    "V": {
      "tab_size": 4,
    },
    "C": {
      "tab_size": 2,
    },
    "C++": {
      "tab_size": 2,
    },
  },
  "lsp": {
    "clangd": {
      "binary": {
        "path": "clangd",
        "arguments": [
          "--background-index",
          "--header-insertion=never",
          "--completion-style=detailed",
          "--experimental-modules-support",
          "--clang-tidy",
          // "--enable-config",
        ],
      },
    },
  },
}
